{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "description": "__MSG_extDescription__",
  "version": "0.1.7",
  "default_locale": "ko",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "__MSG_extShortName__",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://docs.google.com/*",
    "https://mail.google.com/*",
    "https://calendar.google.com/*",
    "https://drive.google.com/*"
  ],
  "commands": {
    "toggle-alerts": {
      "suggested_key": {
        "default": "Alt+Shift+U",
        "mac": "Alt+Shift+U"
      },
      "description": "__MSG_cmdToggle__"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/core/keys.js", "src/core/names.js", "src/content/card.js", "src/sites/youtube.js", "src/content/main.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://docs.google.com/document/*",
        "https://docs.google.com/spreadsheets/*",
        "https://docs.google.com/presentation/*"
      ],
      "js": ["src/core/keys.js", "src/core/names.js", "src/content/card.js", "src/sites/google-editors.js", "src/content/main.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/core/keys.js", "src/core/names.js", "src/content/card.js", "src/sites/gmail.js", "src/content/main.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["src/core/keys.js", "src/core/names.js", "src/content/card.js", "src/sites/calendar.js", "src/content/main.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://drive.google.com/*"],
      "js": ["src/core/keys.js", "src/core/names.js", "src/content/card.js", "src/sites/drive.js", "src/content/main.js"],
      "run_at": "document_idle"
    }
  ]
}
